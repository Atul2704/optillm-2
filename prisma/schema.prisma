generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PromptComplexity {
  SIMPLE
  MEDIUM
  COMPLEX
}

enum ModelUsed {
  PHI_3_MINI
  LLAMA_3
  GPT_4O
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  fullName     String?
  phoneNumber  String?
  companyName  String?
  jobTitle     String?
  country      String?
  createdAt    DateTime @default(now())

  // Optional per-user guardrails
  monthlyBudgetUsd Decimal? @db.Decimal(10, 2)
  monthlyTokenLimit Int?

  // Billing fields
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  stripeSubscriptionStatus String?
  stripePriceId String?
  subscriptionCurrentPeriodEnd DateTime?

  prompts   Prompt[]
}

model Prompt {
  id            String           @id @default(cuid())
  promptText    String
  complexity    PromptComplexity
  modelUsed     ModelUsed
  tokens        Int
  inputTokens   Int              @default(0)
  outputTokens  Int              @default(0)
  estimatedCost Decimal          @db.Decimal(10, 6)
  provider      String?
  rawModel      String?
  strategy      String           @default("cost_aware")
  confidence    Float            @default(0)
  cacheHit      Boolean          @default(false)
  fallbackReason String?
  createdAt     DateTime         @default(now())

  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([modelUsed])
  @@index([complexity])
  @@index([strategy])
  @@index([cacheHit])
}

model AppConfig {
  id String @id @default("singleton")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Router behavior
  abTestEnabled Boolean @default(false)
  abWeightCostAware Int @default(70) // percentage
  abWeightAlwaysGpt4o Int @default(15)
  abWeightConservative Int @default(15)

  rateLimitPerMinute Int @default(30)
  cacheTtlMs Int @default(120000)

  defaultMonthlyBudgetUsd Decimal @default(5.00) @db.Decimal(10, 2)
  defaultMonthlyTokenLimit Int @default(200000)

  // Pricing (USD per 1M tokens)
  gpt4oInputPer1m Decimal @default(2.50) @db.Decimal(12, 6)
  gpt4oOutputPer1m Decimal @default(10.00) @db.Decimal(12, 6)
  llama3InputPer1m Decimal @default(0.59) @db.Decimal(12, 6)
  llama3OutputPer1m Decimal @default(0.79) @db.Decimal(12, 6)
  phi3InputPer1m Decimal @default(0.05) @db.Decimal(12, 6)
  phi3OutputPer1m Decimal @default(0.08) @db.Decimal(12, 6)

  claudeInputPer1m Decimal @default(3.00) @db.Decimal(12, 6)
  claudeOutputPer1m Decimal @default(15.00) @db.Decimal(12, 6)
  claudeHaikuInputPer1m Decimal @default(0.25) @db.Decimal(12, 6)
  claudeHaikuOutputPer1m Decimal @default(1.25) @db.Decimal(12, 6)
  geminiProInputPer1m Decimal @default(1.25) @db.Decimal(12, 6)
  geminiProOutputPer1m Decimal @default(5.00) @db.Decimal(12, 6)
  geminiFlashInputPer1m Decimal @default(0.075) @db.Decimal(12, 6)
  geminiFlashOutputPer1m Decimal @default(0.30) @db.Decimal(12, 6)
  mistralLargeInputPer1m Decimal @default(2.00) @db.Decimal(12, 6)
  mistralLargeOutputPer1m Decimal @default(6.00) @db.Decimal(12, 6)
  mistralMediumInputPer1m Decimal @default(0.40) @db.Decimal(12, 6)
  mistralMediumOutputPer1m Decimal @default(0.40) @db.Decimal(12, 6)
  mistralSmallInputPer1m Decimal @default(0.20) @db.Decimal(12, 6)
  mistralSmallOutputPer1m Decimal @default(0.20) @db.Decimal(12, 6)

  // Alerting
  slackWebhookUrl String?
  dailySpendAlertUsd Decimal? @db.Decimal(10, 2)
  fallbackRateAlertPercent Int? // 0-100
}

